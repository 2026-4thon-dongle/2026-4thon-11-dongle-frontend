# api/common.md (2026-11-16). Origin only; request paths already include /api/.
VITE_API_BASE_URL=https://dongle-api.zanviq.dev
# Development demos only. Production always uses the API.
VITE_API_MOCK=false
# Auth codes for the deployed test server: https://dongle-mail.zanviq.dev
# Dev/QA preview screens (/preview/*). Always on in `npm run dev`. For a build, set true only for QA; leave unset for the release build.
VITE_ENABLE_PREVIEW=false
